  //Linked list in cpp

#include <iostream>
using namespace std;

struct Coach {
    int number;
    Coach* next;
};

int main() {

    // Creating three nodes
    Coach c1{1, nullptr};
    Coach c2{2, nullptr};
    Coach c3{3, nullptr};

    // Connecting the nodes
    c1.next = &c2;
    c2.next = &c3;

    // Traversing the linked list
    Coach* temp = &c1;

    while (temp != nullptr) {
        cout << temp->number << " ";
        temp = temp->next;
    }

    return 0;
}
//OUTPUT
1 2
//Write a cpp program using a self-referential Patient structure.Each patient has a name and a pointer to the next patient.Connect three patients in queue order and print all names using a loop
Expected output: Aman Riya Kabir

#include <iostream>
using namespace std;

// Self-referential structure
struct Patient {
    string name;
    Patient* next;
};

int main() {

    // Creating three patients
    Patient p1{"Aman", nullptr};
    Patient p2{"Riya", nullptr};
    Patient p3{"Kabir", nullptr};

    // Connecting patients in queue order
    p1.next = &p2;
    p2.next = &p3;

    // Printing all patient names
    Patient* temp = &p1;

    while (temp != nullptr) {
        cout << temp->name << " ";
        temp = temp->next;
    }

    return 0;
}
OUTPUT:
Aman Riya Kabir
//write ac++ program using a self-referential song structure.
create three songs, conncect them in playing order, and dispalya
all song titles by moving through the next pointers.

#include <iostream>
using namespace std;

struct Song {
    string title;
    Song* next;
};

int main() {
    Song s1, s2, s3;

    s1.title = "Shape of You";
    s2.title = "Perfect";
    s3.title = "Believer";

    // Connect songs in playing order
    s1.next = &s2;
    s2.next = &s3;
    s3.next = NULL;

    // Display all song titles
    Song* temp = &s1;

    while (temp != NULL) {
        cout << temp->title << endl;
        temp = temp->next;
    }

    return 0;
}
//OUTPUT
Shape of You
Perfect
Believer

