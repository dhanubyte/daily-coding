#include <iostream>
using namespace std;
const int MAX_SIZE=100;
    struct Heap {
        int arr[MAX_SIZE];
        int size;
    };
void initHeap(Heap &h){
    h.size=0;
}
bool isEmpty(const Heap &h){
    return h.size==0;
    
}
bool isFull(const Heap &h){
    return h.size==MAX_SIZE;
}
inline int parent(int i){
    return (i-1)/2;
}
inline int leftChild(int i){
    return 2*i+1;
}
inline int rightChild(int i){
    return 2*i+2;
}
inline void swap(int &a, int &b){
    int temp=a;
    a=b;
    b=temp;
}


int main() {
    // Write C++ code here
    Heap h;
    initHeap(h);
    int sampleData[]={50,30,70,20,40,60,80};
    for(int val:sampleData){
        h.arr[h.size++]=val;
    }
    cout<<"Heap current size: " << h.size <<"\n";
    cout<<"Root element: " << h.arr[0] << "\n";
    int idx=2;
    cout<<"Node at index "<< idx << " (" << h.arr[idx] << "):\n";
    cout<<"Parent Child: "<<parent(idx) << " -> Value: "<<h.arr[parent(idx)] << "\n";
    cout<<"Left Child: "<< leftChild(idx) << " -> Value: "<< h.arr[leftChild(idx)]<<"\n";
    cout<<"Right Child: " << rightChild(idx) << " -> Value: "<< h.arr[rightChild(idx)]<<"\n";
    
   
    
    return 0;
}
